<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/add_backdrop"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/add_dialog_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/widget_dialog_bg"
        android:clickable="true"
        android:focusable="true"
        android:minWidth="300dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/widget_add_title"
            android:textColor="@color/widget_ink"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/add_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/widget_input_bg"
            android:hint="@string/widget_add_hint"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences|textAutoCorrect"
            android:maxLength="80"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="@color/widget_ink"
            android:textColorHint="@color/widget_ink3"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/add_chip_today"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/widget_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/widget_add_today"
                android:textColor="@color/widget_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/add_chip_tomorrow"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/widget_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/widget_add_tomorrow"
                android:textColor="@color/widget_ink"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/add_btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/widget_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/widget_add_cancel"
                android:textColor="@color/widget_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/add_btn_submit"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/widget_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="84dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/widget_add_submit"
                android:textColor="@color/widget_on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
