<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/money_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:id="@+id/money_header_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/money_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_money_header"
                android:textColor="@color/widget_ink2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/money_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="₹0"
                android:textColor="@color/widget_ink"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/money_budget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_ink3"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/money_scan_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_btn_ghost"
            android:clickable="true"
            android:contentDescription="@string/widget_money_scan_cd"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_scan" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/money_add_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_add_btn_bg"
            android:clickable="true"
            android:contentDescription="@string/widget_money_add_cd"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_add" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/money_recent_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_row_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/money_recent_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/money_recent_1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingEnd="8dp"
                android:textColor="@color/widget_ink"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/money_recent_1_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink2"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/money_recent_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/money_recent_2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingEnd="8dp"
                android:textColor="@color/widget_ink2"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/money_recent_2_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_ink3"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/money_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:maxLines="2"
            android:text="@string/widget_money_empty"
            android:textColor="@color/widget_ink2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
